// ============================================================================
// File: prog_arith.mem
// ============================================================================
645 // Addr 0: LDI R1, 4'b0101   (R1 = 5)
683 // Addr 1: LDI R2, 4'b0011   (R2 = 3)
060 // Addr 2: ADD R1, R2        (R1 = 5 + 3 = 8, C=0, Z=0)
940 // Addr 3: STORE R1, 0       (DMEM[0] = R1 = 8)
645 // Addr 4: LDI R1, 4'b0101   (R1 = 5)
160 // Addr 5: SUB R1, R2        (R1 = 5 - 3 = 2, C=1, Z=0)
941 // Addr 6: STORE R1, 1       (DMEM[1] = R1 = 2)
800 // Addr 7: LOAD R0, 0        (R0 = DMEM[0] = 8)
1A0 // Addr 8: SUB R2, R2        (R2 = 3 - 3 = 0, C=1, Z=1)
A09 // Addr 9: JMP 9             (Infinite loop at addr 9)