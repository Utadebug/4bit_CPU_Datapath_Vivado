// ============================================================================
// File: prog_logic.mem
// ============================================================================
64C // Addr 0:  LDI R1, 4'b1100  (R1 = 12)
68A // Addr 1:  LDI R2, 4'b1010  (R2 = 10)
7D0 // Addr 2:  MOV R3, R1       (R3 = R1 = 12)
2E0 // Addr 3:  AND R3, R2       (R3 = 1100 & 1010 = 1000)
7D0 // Addr 4:  MOV R3, R1       (R3 = R1 = 12)
3E0 // Addr 5:  OR  R3, R2       (R3 = 1100 | 1010 = 1110)
460 // Addr 6:  XOR R1, R2       (R1 = 1100 ^ 1010 = 0110)
790 // Addr 7:  MOV R2, R1       (R2 = R1 = 0110)
605 // Addr 8:  LDI R0, 4'b0101  (R0 = 5)
500 // Addr 9:  NOT R0           (R0 = ~0101 = 1010)
6CA // Addr 10: LDI R3, 4'b1010  (R3 = 10)
4F0 // Addr 11: XOR R3, R3       (R3 = 1010 ^ 1010 = 0000, Z=1)
A0E // Addr 12: JMP 14           (Jump to stop/idle)