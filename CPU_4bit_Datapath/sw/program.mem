// ============================================================================
// File: program.mem
// ============================================================================
645 // Addr 0: LDI R1, 4'b0101  (R1 = 5)
683 // Addr 1: LDI R2, 4'b0011  (R2 = 3)
060 // Addr 2: ADD R1, R2       (R1 = 5 + 3 = 8)
6CA // Addr 3: LDI R3, 4'b1010  (R3 = 10)
470 // Addr 4: XOR R1, R3       (R1 = 8 ^ 10 = 2)
A05 // Addr 5: JMP 5            (Infinite loop at addr 5)